# MSFS 2024 Career & Logbook Tracker Environment Configuration

# Server Port
PORT=3001

# MongoDB Connection URI (Atlas or Local)
# If left blank, the server will automatically launch an in-memory MongoDB instance for development
MONGODB_URI=mongodb://localhost:27017/airbound

# SimConnect Configuration
# Set to 'true' to force mock telemetry simulation even if MSFS is running
USE_MOCK_SIMCONNECT=false

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
