# ========================================================
# AIRBOUND - MSFS 2024 Career Tracker Configuration
#
# NOTE: ALL SETTINGS BELOW ARE 100% OPTIONAL!
# Airbound works out-of-the-box on Desktop with zero configuration:
# - No database setup needed (Auto-boots embedded persistent DB in ./data/db)
# - No map API key needed (100% open-source Leaflet + OSM / Carto basemaps)
# - Directly hooks into MSFS 2024 via local SimConnect
# ========================================================

# Server Port (Default: 3001)
PORT=3001

# Optional Database Override:
# Leave blank to use the built-in embedded persistent local database (./data/db).
# Only set this if you want to connect to a remote MongoDB Atlas cluster or custom Mongo instance.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/airbound

# Optional Custom Data Directory for local database:
# AIRBOUND_DATA_DIR=./data/db

# SimConnect Mock Simulation:
# Set to 'true' to test flight mechanics without MSFS 2024 running.
USE_MOCK_SIMCONNECT=false

# Optional Pilot Passcode Protection:
# Leave blank for local open access. Set a passcode if exposing your server to external networks.
# PILOT_PASSCODE=1234
