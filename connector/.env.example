# ==============================================================
# AIRBOUND MSFS CONNECTOR CONFIGURATION
# ==============================================================

# Airbound Cloud or Local URL (No trailing slash)
# For local dev: http://localhost:3001
# For Vercel: https://your-airbound-app.vercel.app
AIRBOUND_API_URL=http://localhost:3001

# Callsign of your Airbound pilot profile
PILOT_CALLSIGN=James

# Pilot Passcode (must match PILOT_PASSCODE set in Vercel environment variables)
# Leave blank if no passcode is set in Vercel or running local dev
AIRBOUND_PASSCODE=

# Telemetry update rate in milliseconds (1000 = 1 Hz)
POLL_INTERVAL_MS=1000

# Set to true to test simulated telemetry without MSFS running
USE_MOCK=false
